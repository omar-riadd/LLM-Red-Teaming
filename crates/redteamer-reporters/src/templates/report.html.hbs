<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>llm-redteamer report — {{session_id}}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; }
    .vulnerable { color: #b00020; font-weight: bold; }
    .resistant { color: #1b5e20; }
    .partial { color: #e65100; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 0.4rem 0.6rem; text-align: left; }
    th { background: #f5f5f5; }
  </style>
</head>
<body>
  <h1>LLM Red-Teaming Report</h1>
  <p>Session <code>{{session_id}}</code> — generated {{generated_at}}</p>
  <p><strong>{{summary.vulnerable_count}}</strong> vulnerable /
     {{summary.total}} findings</p>

  <table>
    <thead>
      <tr>
        <th>Title</th><th>Verdict</th><th>Probe</th><th>Detector</th><th>OWASP</th>
      </tr>
    </thead>
    <tbody>
      {{#each findings}}
      <tr>
        <td>{{title}}</td>
        <td class="{{verdict}}">{{verdict}}</td>
        <td>{{probe_name}}</td>
        <td>{{detector_name}}</td>
        <td>{{owasp_summary}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>
