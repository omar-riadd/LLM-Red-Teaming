<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>llm-redteamer report — {{session_id}}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #1f2937; }
    h1, h2 { color: #111827; }
    .vulnerable { color: #b00020; font-weight: bold; }
    .resistant { color: #1b5e20; }
    .partial { color: #e65100; }
    .meta { margin-bottom: 1.5rem; background: #f9fafb; padding: 1rem; border-radius: 6px; border: 1px solid #e5e7eb; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 2rem; }
    th, td { border: 1px solid #d1d5db; padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
    th { background: #f3f4f6; }
    pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 0.85rem; }
  </style>
</head>
<body>
  <h1>LLM Red-Teaming Security Report</h1>
  <div class="meta">
    <p><strong>Session:</strong> <code>{{session_id}}</code> | <strong>Target:</strong> <code>{{target_name}}</code> (model: <code>{{target_model}}</code>) | <strong>Generated:</strong> {{generated_at}}</p>
    <p><strong>Records Evaluated:</strong> {{summary.total_records}} | <strong>Vulnerable Findings:</strong> {{summary.total_findings}} | <strong>Highest CVSS v4.0:</strong> {{summary.highest_score}} (Critical: {{summary.critical}}, High: {{summary.high}}, Medium: {{summary.medium}}, Low: {{summary.low}})</p>
  </div>

  <h2>Per-Probe Attack Success Rate (ASR)</h2>
  <table>
    <thead>
      <tr>
        <th>Probe</th><th>OWASP Category</th><th>Total</th><th>Vulnerable</th><th>Partial</th><th>Resistant</th><th>Errors</th><th>ASR</th>
      </tr>
    </thead>
    <tbody>
      {{#each probe_summaries}}
      <tr>
        <td><code>{{probe_name}}</code></td>
        <td>{{category}}</td>
        <td>{{total}}</td>
        <td class="vulnerable">{{vulnerable}}</td>
        <td class="partial">{{partial}}</td>
        <td class="resistant">{{resistant}}</td>
        <td>{{errors}}</td>
        <td><strong>{{asr_percent}}</strong></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <h2>Confirmed Findings</h2>
  <table>
    <thead>
      <tr>
        <th>Title</th><th>CVSS v4.0</th><th>Mutation</th><th>Detector</th><th>Prompt</th><th>Response</th>
      </tr>
    </thead>
    <tbody>
      {{#each findings}}
      <tr>
        <td><strong>{{title}}</strong><br/><small>{{owasp_summary}}</small></td>
        <td class="{{verdict}}">{{cvss_score}} ({{cvss_band}})<br/><small><code>{{cvss_vector}}</code></small></td>
        <td><code>{{mutation_type}}</code></td>
        <td><code>{{detector_name}}</code></td>
        <td><pre>{{prompt}}</pre></td>
        <td><pre>{{response}}</pre></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>
